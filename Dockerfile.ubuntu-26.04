# ===============================
# Final Runtime Image (Ubuntu 26.04)
# ===============================
FROM ubuntu:26.04

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    ccache \
    curl \
    libpcap-dev \
    python3-minimal \
    tcpdump \
    libssl-dev \
    libpcre2-dev \
    libavl1 \
    libev4 \
    libprotobuf-c1 \
    python-is-python3 \
    libprotobuf-dev \
    protobuf-compiler \
    protobuf-compiler-grpc \
    libgrpc-dev \
    libgrpc++-dev && \
    rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV HOME=/root
ENV PATH=$HOME/.local/bin:$PATH
ENV VIRTUAL_ENV=$HOME/p4-python-venv
RUN uv venv --seed $VIRTUAL_ENV
ENV PATH=$VIRTUAL_ENV/bin:$PATH

COPY --from=nanomsg /output/usr/local /usr/local/
COPY --from=thrift /output/usr/local /usr/local/
#COPY --from=libyang /output/usr/local /usr/local/
#COPY --from=sysrepo /output/usr/local /usr/local/
#COPY --from=sysrepo /output/etc /etc/

RUN ldconfig

RUN uv pip install thrift==0.22.0 protobuf==4.21.12 grpcio==1.75.1 && \
    echo "source \$HOME/p4-python-venv/bin/activate" >> $HOME/.bashrc
